{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "temple-volunteers-ai",
  "main": "worker.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://arraina.github.io"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
