# ---------------------------------------------------------------------------
# Frontend (React) config — safe to expose in the built app.
# Copy this file to .env and fill in values from your Firebase project:
#   Firebase Console > Project Settings > General > Your Apps (Web)
# ---------------------------------------------------------------------------
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Firebase Cloud Messaging (web push) — public VAPID key from
#   Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
REACT_APP_FIREBASE_VAPID_KEY=

# AI Create (natural-language event/task creation via Google Gemini).
# Preferred: point at a Cloudflare Worker proxy that holds the key server-side.
REACT_APP_AI_ENDPOINT=
# Fallback (less secure — key ships in the app; restrict it by HTTP referrer):
REACT_APP_GEMINI_API_KEY=
REACT_APP_GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# Reminder sender (GitHub Actions) — SECRETS. Do NOT put these in .env for the
# frontend and do NOT commit them. Set them as GitHub repository secrets.
# See reminder-sender/README or SETUP for details.
# ---------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT   -> full JSON of a Firebase service account key
# WHATSAPP_ACCESS_TOKEN      -> permanent Meta System User token
# WHATSAPP_PHONE_NUMBER_ID   -> Meta WhatsApp phone number ID
# WHATSAPP_TEMPLATE_NAME     -> approved reminder template name (e.g. task_reminder)
# WHATSAPP_TEMPLATE_LANG     -> template language code (e.g. en_US)
# EMAIL_API_KEY              -> Resend/Brevo API key (optional email channel)
# EMAIL_FROM                 -> verified from address (optional email channel)
