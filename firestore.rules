rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // Admin status is granted ONLY by an admins/{uid} doc with isAdmin == true.
    // No hardcoded admin emails.
    function isAdmin() {
      return verifiedUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    function noAdminsYet() {
      // Allows the very first signed-in user to claim admin (bootstrap only).
      return !exists(/databases/$(database)/documents/adminsMeta/count)
        || get(/databases/$(database)/documents/adminsMeta/count).data.total == 0;
    }

    function isOwnDocument(documentId) {
      return verifiedUser() && request.auth.uid == documentId;
    }

    function onlyAssignmentFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'assignedVolunteers', 'status', 'updatedAt'
      ]);
    }

    function hasValidPhoneNumber() {
      return request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.matches('^\\+[1-9][0-9]{7,14}$');
    }

    function hasNoPhoneNumber() {
      return request.resource.data.phoneNumber == '';
    }

    function phoneChangeIsVerified() {
      return request.resource.data.phoneNumber == resource.data.phoneNumber
        || (request.auth.token.phone_number is string
            && request.resource.data.phoneNumber == request.auth.token.phone_number);
    }

    function isSelfSignup() {
      return resource.data.openForSignup == true
        && resource.data.status == 'open'
        && onlyAssignmentFieldsChanged()
        && !(request.auth.uid in resource.data.assignedVolunteers)
        && request.auth.uid in request.resource.data.assignedVolunteers
        && request.resource.data.assignedVolunteers.size()
          == resource.data.assignedVolunteers.size() + 1
        && request.resource.data.assignedVolunteers.hasAll(resource.data.assignedVolunteers)
        && request.resource.data.assignedVolunteers.size() <= resource.data.volunteersNeeded
        && request.resource.data.status
          == (request.resource.data.assignedVolunteers.size() == resource.data.volunteersNeeded
            ? 'filled'
            : resource.data.status);
    }

    function isSelfWithdrawal() {
      return resource.data.openForSignup == true
        && onlyAssignmentFieldsChanged()
        && request.auth.uid in resource.data.assignedVolunteers
        && !(request.auth.uid in request.resource.data.assignedVolunteers)
        && request.resource.data.assignedVolunteers.size()
          == resource.data.assignedVolunteers.size() - 1
        && resource.data.assignedVolunteers.hasAll(request.resource.data.assignedVolunteers)
        && request.resource.data.status
          == (resource.data.status == 'filled' ? 'open' : resource.data.status);
    }

    // Fields a volunteer may edit on their OWN profile.
    function volunteerSelfEditableFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'firstName', 'lastName', 'name', 'phoneNumber',
        'skills', 'availability', 'notificationPrefs', 'pushTokens', 'updatedAt',
        'whatsappOptIn', 'whatsappOptInAt', 'whatsappOptInSource', 'invitationStatus',
        'participationStatus'
      ]);
    }

    // ----- admins -----
    match /admins/{adminId} {
      allow read: if isAdmin() || isOwnDocument(adminId);
      // First admin can self-claim when none exist; afterwards only admins manage admins.
      allow create: if isAdmin()
        || (verifiedUser() && request.auth.uid == adminId && noAdminsYet());
      allow update, delete: if isAdmin();
    }

    // adminsMeta/count tracks how many admins exist (for bootstrap check).
    match /adminsMeta/{docId} {
      allow read: if verifiedUser();
      allow write: if isAdmin() || (verifiedUser() && noAdminsYet());
    }

    // ----- volunteers -----
    match /volunteers/{volunteerId} {
      allow get: if isAdmin() || isOwnDocument(volunteerId);
      allow list: if isAdmin();
      // Admins manage anyone; a user can create their own profile at signup.
      allow create: if isAdmin()
        || (signedIn()
            && request.auth.uid == volunteerId
            && request.resource.data.email == request.auth.token.email
            && (hasNoPhoneNumber()
                || (hasValidPhoneNumber()
                    && request.auth.token.phone_number is string
                    && request.resource.data.phoneNumber == request.auth.token.phone_number)));
      allow update: if isAdmin()
        || (verifiedUser()
            && request.auth.uid == volunteerId
            && volunteerSelfEditableFields()
            && (hasNoPhoneNumber() || hasValidPhoneNumber())
            && phoneChangeIsVerified());
      allow delete: if isAdmin();
    }

    // ----- tasks -----
    match /tasks/{taskId} {
      allow read: if verifiedUser();
      allow create, delete: if isAdmin();
      // Admins can update anything. Volunteers may only self-add/remove
      // themselves on the assignedVolunteers array of an open task.
      allow update: if isAdmin()
        || (verifiedUser() && (isSelfSignup() || isSelfWithdrawal()));
    }

    // ----- hour logs (check-in / check-out) -----
    match /hourLogs/{logId} {
      allow read: if isAdmin()
        || (verifiedUser() && resource.data.volunteerId == request.auth.uid);
      allow create: if isAdmin()
        || (verifiedUser() && request.resource.data.volunteerId == request.auth.uid);
      allow update: if isAdmin()
        || (verifiedUser() && resource.data.volunteerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ----- events (admins author; everyone reads) -----
    match /events/{id} {
      allow read: if verifiedUser();
      allow write: if isAdmin();
    }

    // ----- announcements (admins author; everyone reads) -----
    match /announcements/{id} {
      allow read: if verifiedUser();
      allow write: if isAdmin();
    }

    // Event planning workspaces and reusable templates are admin-managed.
    match /eventMeetings/{id} {
      allow read, write: if isAdmin();
    }
    match /eventTemplates/{id} {
      allow read, write: if isAdmin();
    }

    // Volunteers submit one feedback document per event under their own uid.
    match /eventFeedback/{id} {
      allow read: if isAdmin();
      allow create, update: if verifiedUser()
        && request.resource.data.volunteerId == request.auth.uid
        && id == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if isAdmin();
    }

    // ----- reminders & sent messages: server-only, never client-accessible -----
    match /reminders/{id} {
      allow read, write: if false;
    }
    match /sentMessages/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
